CREATE OR REPLACE REST WEBSERVICE sales_performance_rest
    CONNECTION (
        CHUNKSIZE = 1000
        CHUNKTIMEOUT = 1000
        QUERYTIMEOUT = 900000
        POOLENABLED = true
        POOLINITSIZE = 0
        POOLMAXACTIVE = 30
    )
    DEFAULTREPRESENTATION = JSON
    SUPPORTEDREPRESENTATIONS (HTML, XML, JSON)    AUTHENTICATION (BASIC VDP )

    RESOURCES (
        VIEW final_sales_performance_rv FIELDS (
            city : 'text', 
            state : 'text', 
            brand_name : 'text', 
            category_name : 'text', 
            store_name : 'text', 
            order_month : 'long', 
            order_year : 'long', 
            total_units : 'int', 
            total_orders : 'long', 
            total_net_revenue : 'double', 
            total_gross_revenue : 'double', 
            unique_customers : 'long', 
            orders_per_customer : 'long', 
            net_revenue_per_customer : 'double', 
            discount_rate : 'double', 
            avg_discount : 'double', 
            total_discount_amount : 'double', 
            avg_order_value : 'double', 
            avg_selling_price : 'double', 
            avg_units_per_order : 'double'
        )
    )
    OPTIONS ( NULLVALUESASEMPTYXMLELEMENTS = false
        ALLOW_CORS_ORIGINS (*) DISABLED
        PROCESS_FUNCTIONS_IN_SELECT_PARAMETER = true ) 
    OPENAPI2 ( API_VERSION = '1.0.0' ) 
    FOLDER = '/05_data_service';

# #######################################
# WEBCONTAINER WEB SERVICE DEPLOYMENTS
# #######################################
UNDEPLOY IF EXISTS WEBSERVICE sales_performance_rest;

DEPLOY WEBSERVICE sales_performance_rest;

