CREATE OR REPLACE VIEW iv_order_items_enriched FOLDER = '/03_integrated_views' AS SELECT bv_orderitems.order_id AS order_id, bv_orderitems.item_id AS item_id, bv_orderitems.product_id AS product_id, bv_orderitems.quantity AS quantity, bv_orderitems.list_price AS list_price, bv_orderitems.discount AS discount, bv_products.product_name AS product_name, bv_products.model_year AS model_year, bv_brands.brand_name AS brand_name, bv_categories.category_name AS category_name FROM ((bv_orderitems AS bv_orderitems LEFT OUTER JOIN bv_products AS bv_products ON bv_orderitems.product_id = bv_products.product_id ) LEFT OUTER JOIN bv_brands AS bv_brands ON bv_products.brand_id = bv_brands.brand_id ) LEFT OUTER JOIN bv_categories AS bv_categories ON bv_products.category_id = bv_categories.category_id ;

ALTER VIEW iv_order_items_enriched
 LAYOUT (bv_orderitems = [266, 142, 200, 200], bv_products = [590, 143, 200, 200], bv_brands = [265, 25, 200, 200], bv_categories = [269, 271, 200, 200]);

CREATE OR REPLACE VIEW iv_orders_enriched FOLDER = '/03_integrated_views' AS SELECT bv_orders.order_id AS order_id, bv_orders.order_status AS order_status, bv_orders.order_date AS order_date, bv_orders.required_date AS required_date, bv_orders.shipped_date AS shipped_date, bv_orders.store_id AS store_id, bv_customers.first_name AS first_name, bv_customers.last_name AS last_name, bv_stores.store_name AS store_name, bv_stores.city AS city, bv_stores.state AS state, bv_orders.customer_id AS customer_id FROM (bv_orders AS bv_orders LEFT OUTER JOIN bv_customers AS bv_customers ON bv_orders.customer_id = bv_customers.customer_id ) LEFT OUTER JOIN bv_stores AS bv_stores ON bv_orders.store_id = bv_stores.store_id ;

ALTER VIEW iv_orders_enriched
 LAYOUT (bv_orders = [165, 62, 200, 200], bv_customers = [626, 50, 200, 200], bv_stores = [403, 146, 200, 200]);

CREATE OR REPLACE VIEW iv_order_items_revenue FOLDER = '/03_integrated_views' AS SELECT iv_order_items_enriched.order_id AS order_id, iv_order_items_enriched.item_id AS item_id, iv_order_items_enriched.product_id AS product_id, iv_order_items_enriched.quantity AS quantity, iv_order_items_enriched.list_price AS list_price, iv_order_items_enriched.discount AS discount, iv_order_items_enriched.product_name AS product_name, iv_order_items_enriched.model_year AS model_year, iv_order_items_enriched.brand_name AS brand_name, iv_order_items_enriched.category_name AS category_name, (quantity*list_price) AS gross_revenue, ((quantity*list_price)*discount) AS discount_amount, ((quantity*list_price)*(1-discount)) AS net_revenue FROM iv_order_items_enriched;

ALTER VIEW iv_order_items_revenue
 LAYOUT (iv_order_items_enriched = [20, 20, 200, 200]);

CREATE OR REPLACE VIEW iv_orders_enriched_features FOLDER = '/03_integrated_views' AS SELECT iv_orders_enriched.order_id AS order_id, iv_orders_enriched.customer_id AS customer_id, iv_orders_enriched.store_id AS store_id, iv_orders_enriched.order_date AS order_date, iv_orders_enriched.required_date AS required_date, iv_orders_enriched.shipped_date AS shipped_date, iv_orders_enriched.order_status AS order_status, iv_orders_enriched.store_name AS store_name, iv_orders_enriched.city AS city, iv_orders_enriched.state AS state, ((first_name||' ')||last_name) AS customer_name, getyear(order_date) AS order_year, getmonth(order_date) AS order_month FROM iv_orders_enriched;

ALTER VIEW iv_orders_enriched_features
 LAYOUT (iv_orders_enriched = [20, 20, 200, 200]);

CREATE OR REPLACE VIEW iv_sales_fact FOLDER = '/03_integrated_views' AS SELECT iv_orders_enriched_features.order_id AS order_id, iv_orders_enriched_features.customer_id AS customer_id, iv_orders_enriched_features.store_id AS store_id, iv_orders_enriched_features.order_date AS order_date, iv_orders_enriched_features.required_date AS required_date, iv_orders_enriched_features.shipped_date AS shipped_date, iv_orders_enriched_features.order_status AS order_status, iv_orders_enriched_features.store_name AS store_name, iv_orders_enriched_features.city AS city, iv_orders_enriched_features.state AS state, iv_orders_enriched_features.customer_name AS customer_name, iv_orders_enriched_features.order_year AS order_year, iv_orders_enriched_features.order_month AS order_month, iv_order_items_revenue.item_id AS item_id, iv_order_items_revenue.product_id AS product_id, iv_order_items_revenue.quantity AS quantity, iv_order_items_revenue.list_price AS list_price, iv_order_items_revenue.discount AS discount, iv_order_items_revenue.product_name AS product_name, iv_order_items_revenue.model_year AS model_year, iv_order_items_revenue.brand_name AS brand_name, iv_order_items_revenue.category_name AS category_name, iv_order_items_revenue.gross_revenue AS gross_revenue, iv_order_items_revenue.discount_amount AS discount_amount, iv_order_items_revenue.net_revenue AS net_revenue FROM iv_orders_enriched_features AS iv_orders_enriched_features LEFT OUTER JOIN iv_order_items_revenue AS iv_order_items_revenue ON iv_orders_enriched_features.order_id = iv_order_items_revenue.order_id ;

ALTER VIEW iv_sales_fact
 LAYOUT (iv_orders_enriched_features = [185, 65, 200, 200], iv_order_items_revenue = [580, 65, 200, 200]);

CREATE OR REPLACE VIEW final_sales_performance_rv FOLDER = '/04_final_views' AS SELECT city AS city, state AS state, brand_name AS brand_name, category_name AS category_name, store_name AS store_name, order_month AS order_month, order_year AS order_year, sum(quantity) AS total_units, count(order_id) AS total_orders, round(sum(net_revenue), 2) AS total_net_revenue, round(sum(gross_revenue), 2) AS total_gross_revenue, count(customer_id) AS unique_customers, (count(order_id)/nullif(count(customer_id), 0)) AS orders_per_customer, (round(sum(net_revenue), 2)/nullif(count(customer_id), 0)) AS net_revenue_per_customer, (sum(discount_amount)/nullif(sum(gross_revenue), 0)) AS discount_rate, round(avg(discount), 3) AS avg_discount, round(sum(discount_amount), 3) AS total_discount_amount, round(((sum(net_revenue)*1.0)/nullif(count(DISTINCT order_id), 0)), 2) AS avg_order_value, round((sum(net_revenue)/nullif(sum(quantity), 0)), 2) AS avg_selling_price, round(((sum(quantity)*1.0)/nullif(count(DISTINCT order_id), 0)), 2) AS avg_units_per_order FROM iv_sales_fact GROUP BY city, brand_name, state, category_name, store_name, order_month, order_year ORDER BY order_year ASC, order_month ASC;

ALTER VIEW final_sales_performance_rv
 LAYOUT (iv_sales_fact = [296, 131, 200, 200]);

